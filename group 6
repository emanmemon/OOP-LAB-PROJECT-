#include <iostream>
#include <vector>
using namespace std;

// Base class: Person
class Person {
protected:
    string name;
    int age;
public:
    Person(string n, int a) : name(n), age(a) {}
    virtual void displayInfo() const {
        cout << "Name: " << name << ", Age: " << age << endl;
    }
};

// Derived class: Passenger
class Passenger : public Person {
public:
    Passenger(string n, int a) : Person(n, a) {}
    void displayInfo() const override {
        cout << "Passenger - ";
        Person::displayInfo();
    }
};

// Derived class: Driver
class Driver : public Person {
    string licenseNumber;
public:
    Driver(string n, int a, string ln) : Person(n, a), licenseNumber(ln) {}
    void displayInfo() const override {
        cout << "Driver - ";
        Person::displayInfo();
        cout << "License Number: " << licenseNumber << endl;
    }
};

// Class: BusRoute
class BusRoute {
public:
    string startLocation, endLocation;
    double distance;

    BusRoute(string start, string end, double d) : startLocation(start), endLocation(end), distance(d) {}

    void displayRoute() const {
        cout << "Route: " << startLocation << " -> " << endLocation << " (Distance: " << distance << " km)\n";
    }
};

// Class: Bus
class Bus {
protected:
    string busNumber;
    BusRoute route;
    int totalSeats;
    vector<bool> seats;
public:
    Bus(string num, BusRoute rt, int seats) : busNumber(num), route(rt), totalSeats(seats), seats(seats, true) {}
    
    void displayBusInfo() const {
        cout << "Bus Number: " << busNumber << endl;
        route.displayRoute();
        cout << "Total Seats: " << totalSeats << endl;
    }

    bool bookSeat(int seatNum) {
        if (seatNum > 0 && seatNum <= totalSeats && seats[seatNum - 1]) {
            seats[seatNum - 1] = false;
            cout << "Seat " << seatNum << " booked successfully!\n";
            return true;
        } else {
            cout << "Seat is unavailable or invalid.\n";
            return false;
        }
    }
};

// Class: Ticket
class Ticket {
protected:
    Passenger passenger;
    int seatNumber;
    double fare;
public:
    Ticket(Passenger p, int sn, double f) : passenger(p), seatNumber(sn), fare(f) {}
    void displayTicket() const {
        cout << "\n--- Ticket Details ---\n";
        passenger.displayInfo();
        cout << "Seat Number: " << seatNumber << ", Fare: $" << fare << endl;
    }
};
Class: Payment
class Payment {
protected:
    double amount;
public:
    Payment(double amt) : amount(amt) {}
    virtual void processPayment() const {
        cout << "Processing payment of $" << amount << endl;
    }
};

// Derived class: CardPayment
class CardPayment : public Payment {
    string cardNumber;
public:
    CardPayment(double amt, string cn) : Payment(amt), cardNumber(cn) {}
    void processPayment() const override {
        cout << "Processing card payment of $" << amount << " using card: " << cardNumber << endl;
    }
};

// Derived class: CashPayment
class CashPayment : public Payment {
public:
    CashPayment(double amt) : Payment(amt) {}
    void processPayment() const override {
        cout << "Processing cash payment of $" << amount << endl;
    }
};

// Class: Maintenance
class Maintenance {
public:
    string busNumber;
    string issue;
    string repairStatus;

    Maintenance(string num, string prob) : busNumber(num), issue(prob), repairStatus("Pending") {}

    void resolveIssue() {
        repairStatus = "Resolved";
        cout << "Issue '" << issue << "' for Bus " << busNumber << " has been resolved.\n";
    }
// Class: Staff
class Staff : public Person {
protected:
    string role;
public:
    Staff(string n, int a, string r) : Person(n, a), role(r) {}

    void displayInfo() const override {
        cout << "Staff - ";
        Person::displayInfo();
        cout << "Role: " << role << endl;
    }
};

// Class: CustomerSupport
class CustomerSupport {
public:
    string query;
    string response;

    CustomerSupport(string q) : query(q), response("Pending") {}

    void resolveQuery(string res) {
        response = res;
        cout << "Query resolved: " << response << endl;
    }

    void displayQuery() {
        cout << "Customer Query: " << query << " - Response: " << response << endl;
    }
};

// Class: TicketValidator
class TicketValidator {
public:
    bool validateTicket(Ticket& ticket) {
        cout << "Ticket validated successfully!\n";
        return true;
    }
};

// Class: ReservationSystem
class ReservationSystem {
public:
    void bookTicket() {
        BusRoute route("Islamabad", "Lahore", 300);
        Bus bus("B001", route, 20);
        bus.displayBusInfo();

        Passenger passenger("Eman", 22);
        int seatNum = 5;

        if (bus.bookSeat(seatNum)) {
            Ticket ticket(passenger, seatNum, 500.0);
            ticket.displayTicket();

            CardPayment payment(500.0, "1234-5678-9012-3456");
            payment.processPayment();

            TicketValidator validator;
            validator.validateTicket(ticket);

            CustomerSupport support("Lost ticket issue");
            support.resolveQuery("Duplicate ticket issued.");
        }
    }
};

// Main Function
int main() {
    ReservationSystem system;
    system.bookTicket();

    Maintenance maintenance("B001", "Engine overheating");
    maintenance.resolveIssue();
    maintenance.displayStatus();

    return 0;
}
